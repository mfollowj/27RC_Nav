            <ode>
              <kp>1e12</kp>
              <kd>1.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <link name="collision_stairs_red_3">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://robocon_ground/meshes/collision/stairs_red_3.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e12</kp>
              <kd>1.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <link name="collision_stairs_red_4">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://robocon_ground/meshes/collision/stairs_red_4.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
