      <inertia ixx="5.395833333333334e-06" iyy="3.6458333333333346e-06" izz="5.395833333333334e-06" ixy="0.0" ixz="0.0" iyz="0.0" />
    </inertial>
    <visual name="front_camera_link_0_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.035 0.025" />
      </geometry>
      <material name="v2_sensor">
        <color rgba=".22 .25 .28 1" />
      </material>
    </visual>
    <collision name="front_camera_link_0_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.035 0.025" />
      </geometry>
    </collision>
    <visual name="sensor_camera_lens_rim">
      <origin xyz="0.014 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius="0.011" length="0.003" />
      </geometry>
      <material name="sensor_identifier_sensor_camera_lens_rim">
        <color rgba=".72 .76 .79 1" />
      </material>
    </visual>
    <visual name="sensor_camera_lens_glass">
      <origin xyz="0.0155 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius="0.0085" length="0.0032" />
      </geometry>
      <material name="sensor_identifier_sensor_camera_lens_glass">
        <color rgba=".04 .30 .50 1" />
      </material>
    </visual>
  </link>
  <joint name="front_camera_mount_joint" type="fixed">
    <parent link="reach_stage" />
    <child link="front_camera_link" />
    <origin xyz="0.07 0 0.255" rpy="0 0.8 0" />
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="br_v2_gpu_lidar" type="gpu_lidar">
      <topic>/br_v2/sim/lidar</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.12217</min_angle>
            <max_angle>0.90757</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <ignition_frame_id>br_v2/lidar_link</ignition_frame_id>
    </sensor>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="br_v2_imu" type="imu">
      <topic>/br_v2/sim/imu</topic>
      <update_rate>200</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ignition_frame_id>br_v2/imu_link</ignition_frame_id>
    </sensor>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive">
      <topic>/br_v2/cmd_vel</topic>
      <front_left_joint>front_left_wheel_drive_joint</front_left_joint>
      <front_right_joint>front_right_wheel_drive_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_drive_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_drive_joint</back_right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheelbase>0.4</wheelbase>
      <wheel_radius>0.12</wheel_radius>
      <min_acceleration>-0.4</min_acceleration>
      <max_acceleration>0.4</max_acceleration>
      <odom_topic>/br_v2/wheel/odometry</odom_topic>
      <tf_topic>/br_v2/wheel/tf</tf_topic>
      <frame_id>br_v2/odom</frame_id>
      <child_frame_id>br_v2/base_footprint</child_frame_id>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
