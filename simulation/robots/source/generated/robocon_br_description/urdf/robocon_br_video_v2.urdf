      <p_gain>6000</p_gain>
      <i_gain>200</i_gain>
      <d_gain>80</d_gain>
      <i_max>100</i_max>
      <i_min>-100</i_min>
      <cmd_max>220.0</cmd_max>
      <cmd_min>-220.0</cmd_min>
      <initial_position>0</initial_position>
