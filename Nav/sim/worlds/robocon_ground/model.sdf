    <!-- ========== 15. L1 层上的两个小障碍（新增）========== -->
    <!-- 视觉网格：1.0(x) x 0.3(y) x 0.15(z)，位于 (0, ±1.65)，z 0.60~0.75 -->
    <link name="collision_l1_obstacle_north">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://robocon_ground/meshes/collision/l1_obstacle_north.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="collision_l1_obstacle_south">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://robocon_ground/meshes/collision/l1_obstacle_south.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
