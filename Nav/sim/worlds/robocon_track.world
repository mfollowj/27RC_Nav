<?xml version="1.0"?>
<!--
  ROBOCON「女娲补天」场地世界（Gazebo Classic + ROS 2 Humble）

  ============================ 本次修改说明 ============================
  原文件只有 1 个光源 + include 场地模型，<plugin> 数量为 0，导致：
    * 没有 libgazebo_ros_init/factory —— 没有 /clock、没有 /spawn_entity，
      机器人无法通过 ROS 生成，传感器话题也无从桥接（README 里"直接跑
      turtlebot3_world.launch.py"其实会另起一个世界，TB3 不会出现在本场地）；
    * 没有 <physics> —— 用 ODE 默认 1ms 步长，但没有任何显式记录；
    * 没有场地外的地面 —— 车开出 11x11 直接掉进虚空。

  本次补齐：gazebo_ros 插件、显式 physics/gravity、场景光照、场地外地面。
  场地本体的碰撞与摩擦修补见 robocon_ground/model.sdf。
  ====================================================================
-->
<sdf version="1.6">
  <world name="robocon_world">

    <!-- ===================== 物理引擎（显式声明） ===================== -->
    <physics name="robocon_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_contacts>100</max_contacts>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <!-- ===================== ROS 2 桥接 ===================== -->
    <!-- 注意（实测坑）：ROS 2 版 gazebo_ros 里
         libgazebo_ros_init.so / libgazebo_ros_factory.so / libgazebo_ros_force_system.so
         注册的是 **SystemPlugin**，只能通过 gzserver 命令行加载：
             gzserver -slibgazebo_ros_init.so -slibgazebo_ros_factory.so <world>
         若把它们写进 world 的 <plugin>，Gazebo 会报
             [Err] World[...] is attempting to load a plugin, but detected an
                   incorrect plugin type. filename[libgazebo_ros_factory.so]
         并且 /spawn_entity 永远不会出现（robot 无法生成）。
         因此这两行只能由启动脚本/gzserver.launch.py 传 -s，不能写在这里。
         world 这一层只能声明 WorldPlugin —— 下面这个 state 插件就是 WorldPlugin，
         它提供 /get_entity_state、/set_entity_state 等调试服务，写在 world 里是合法的。 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>

    <!-- ===================== 光照与场景 ===================== -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <!-- 关阴影：Gazebo Classic(GUI) 在按需重绘/选中高亮时反复重建阴影贴图，
           在 NVIDIA 驱动 + 大网格场地（79 节点 DAE）下很容易卡住；导航仿真不需要阴影 -->
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- ===================== 场地外地面（新增） ===================== -->
    <!-- 无限大的平面会让它与场地地面薄板共面冲突，因此用一块 40x40 的厚板，
         顶面 z=-0.01，比场地地面(顶面 z=0)低 1cm，避免共面接触抖动。 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>40 40 0.04</size>
            </box>
          </geometry>
          <pose>0 0 -0.03 0 0 0</pose>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e12</kp>
                <kd>1.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
              <threshold>1e6</threshold>
            </bounce>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 40 0.04</size>
            </box>
          </geometry>
          <pose>0 0 -0.03 0 0 0</pose>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== 比赛场地 ===================== -->
    <include>
      <uri>model://robocon_ground</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
