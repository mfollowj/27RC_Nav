      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.12217</min_angle>
            <max_angle>0.90757</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <ignition_frame_id>br/lidar_link</ignition_frame_id>
    </sensor>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="br_imu" type="imu">
      <topic>/br/sim/imu</topic>
      <update_rate>200</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ignition_frame_id>br/imu_link</ignition_frame_id>
    </sensor>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="front_camera_link">
    <sensor name="br_color_camera" type="camera">
      <topic>/br/sim/camera/color</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>12.0</far>
        </clip>
      </camera>
    </sensor>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive">
      <topic>/br/cmd_vel</topic>
      <front_left_joint>front_left_wheel_drive_joint</front_left_joint>
      <front_right_joint>front_right_wheel_drive_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_drive_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_drive_joint</back_right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheelbase>0.40</wheelbase>
      <wheel_radius>0.12</wheel_radius>
      <min_acceleration>-0.5</min_acceleration>
      <max_acceleration>0.5</max_acceleration>
      <odom_topic>/br/wheel/odometry</odom_topic>
      <tf_topic>/br/wheel/tf</tf_topic>
      <frame_id>br/odom</frame_id>
      <child_frame_id>br/base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>lift_joint</joint_name>
      <p_gain>1200</p_gain>
      <topic>/br/joint/lift_joint/cmd_pos</topic>
      <i_gain>60</i_gain>
      <d_gain>30</d_gain>
      <i_max>60</i_max>
      <i_min>-60</i_min>
      <cmd_max>120</cmd_max>
      <cmd_min>-120</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>reach_joint</joint_name>
      <p_gain>500</p_gain>
      <topic>/br/joint/reach_joint/cmd_pos</topic>
      <i_gain>0</i_gain>
      <d_gain>5</d_gain>
      <i_max>60</i_max>
      <i_min>-60</i_min>
      <cmd_max>80</cmd_max>
      <cmd_min>-80</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>jaw_left_joint</joint_name>
      <p_gain>500</p_gain>
      <topic>/br/joint/jaw_left_joint/cmd_pos</topic>
      <i_gain>0</i_gain>
      <d_gain>8</d_gain>
      <i_max>60</i_max>
      <i_min>-60</i_min>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>jaw_right_joint</joint_name>
      <p_gain>500</p_gain>
      <topic>/br/joint/jaw_right_joint/cmd_pos</topic>
      <i_gain>0</i_gain>
      <d_gain>8</d_gain>
      <i_max>60</i_max>
      <i_min>-60</i_min>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>cap_flip_joint</joint_name>
      <p_gain>80</p_gain>
      <topic>/br/joint/cap_flip_joint/cmd_pos</topic>
      <i_gain>0</i_gain>
      <d_gain>5</d_gain>
      <i_max>60</i_max>
      <i_min>-60</i_min>
      <cmd_max>25</cmd_max>
      <cmd_min>-25</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/br/sim/joint_states</topic>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>br/base_footprint</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/br/ground_truth/odometry</odom_topic>
      <odom_covariance_topic>/br/ground_truth/odometry_covariance</odom_covariance_topic>
      <tf_topic>/br/ground_truth/pose</tf_topic>
      <gaussian_noise>0</gaussian_noise>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>
  </gazebo>
  <joint name="cap_wrist_mount_joint" type="fixed">
    <parent link="gripper_base" />
    <child link="cap_cradle" />
    <origin xyz="0 0 0" />
  </joint>
  <link name="lidar_pedestal">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="0.001103125" iyy="0.001103125" izz="3.0625000000000006e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <geometry>
        <box size=".035 .035 .295" />
      </geometry>
      <material name="pedestal_grey">
        <color rgba=".22 .24 .26 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size=".035 .035 .295" />
      </geometry>
    </collision>
  </link>
  <joint name="lidar_pedestal_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_pedestal" />
    <origin xyz="-0.18 0 0.2075" />
  </joint>
</robot>