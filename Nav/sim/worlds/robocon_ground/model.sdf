    <link name="collision_stairs_blue_2">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://robocon_ground/meshes/collision/stairs_blue_2.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
