      <odom_topic>/tr_v2/wheel/odometry</odom_topic>
      <tf_topic>/tr_v2/wheel/tf</tf_topic>
      <frame_id>tr_v2/wheel_odom</frame_id>
      <child_frame_id>tr_v2/base_footprint</child_frame_id>
      <wheel_separation>0.57</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <max_linear_velocity>0.25</max_linear_velocity>
      <min_linear_velocity>-0.25</min_linear_velocity>
      <max_angular_velocity>0.6</max_angular_velocity>
      <min_angular_velocity>-0.6</min_angular_velocity>
      <max_linear_acceleration>0.3</max_linear_acceleration>
      <min_linear_acceleration>-0.3</min_linear_acceleration>
    </plugin>
